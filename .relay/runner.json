{
  "namespace": "relay",
  "capacity": {
    "shared_clean": 3,
    "exclusive": 2
  },
  "base": "origin/main",
  "cache_dir": "~/.cache/relay/exec",
  "worktrees": {
    "prepare": ".relay/prepare-worktree.sh"
  },
  "max_retained_failed": 3,
  "poll_timeout": 25,
  "heartbeat_interval": 15,
  "auto_update": true,
  "auto_update_min_interval": 300,
  "limits": {
    "max_five_hour": 0.9,
    "max_seven_day": 0.9
  }
}
