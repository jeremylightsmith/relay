# Deploy secrets for the RE board's Deploy flow, resolved by 1Password at run time.
#
# Checked in on purpose: this file holds ONLY `op://` references and non-secret literals,
# never a secret value. `bin/op_deploy.sh <command>` runs
#   op run --env-file=.relay/deploy.env -- <command>
# which resolves every reference into the command's environment and nowhere else.
#
# Run a deploy by hand from the repo root:
#   bin/op_deploy.sh bin/deploy_fly.sh
#   bin/op_deploy.sh bin/deploy_ios.sh <REF>
#
# Signing in: on a Mac with the 1Password app, `op signin`. Headless runners need a
# 1Password service account with read access to the vault, exported to the runner as
# OP_SERVICE_ACCOUNT_TOKEN.
#
# 1Password setup: one vault named `Relay Deploy`, holding these items and fields
# (item / field  ->  variable):
#   fly / credential                                ->  FLY_API_TOKEN (a `fly tokens create deploy` token)
#   app-store-connect / private-key                 ->  APP_STORE_CONNECT_PRIVATE_KEY
#       the App Store Connect API key: either the raw .p8 PEM text or its base64
#       (the form CI stored it in); bin/deploy_ios.sh accepts both
#   app-store-connect / key-id                      ->  APP_STORE_CONNECT_KEY_ID
#   app-store-connect / issuer-id                   ->  APP_STORE_CONNECT_ISSUER_ID
#   match / password                                ->  MATCH_PASSWORD
#   match / git-basic-authorization                 ->  MATCH_GIT_BASIC_AUTHORIZATION
#   apple-id / username                             ->  FASTLANE_USER, the Apple ID (CI's APPLE_ID)
#   apple-id / app-specific-password                ->  FASTLANE_PASSWORD, the app-specific
#       password (CI's APPLE_APPLICATION_SPECIFIC_PASSWORD)
#   app-config / relay-base-url                     ->  RELAY_BASE_URL (public, baked into the app)
#   app-config / google-ios-client-id               ->  GOOGLE_IOS_CLIENT_ID (public)
#   app-config / google-server-client-id            ->  GOOGLE_SERVER_CLIENT_ID (public)
#
# Every ACTIVE reference below must exist: `op run` fails outright on any reference it cannot
# resolve, and that would block the always-on Fly deploy too, not just the mobile ones. So the
# Android set ships commented out (see the bottom of this file).

FLY_API_TOKEN=op://Relay Deploy/fly/credential

APP_STORE_CONNECT_PRIVATE_KEY=op://Relay Deploy/app-store-connect/private-key
APP_STORE_CONNECT_KEY_ID=op://Relay Deploy/app-store-connect/key-id
APP_STORE_CONNECT_ISSUER_ID=op://Relay Deploy/app-store-connect/issuer-id
MATCH_PASSWORD=op://Relay Deploy/match/password
MATCH_GIT_BASIC_AUTHORIZATION=op://Relay Deploy/match/git-basic-authorization
FASTLANE_USER=op://Relay Deploy/apple-id/username
FASTLANE_PASSWORD=op://Relay Deploy/apple-id/app-specific-password
RELAY_BASE_URL=op://Relay Deploy/app-config/relay-base-url
GOOGLE_IOS_CLIENT_ID=op://Relay Deploy/app-config/google-ios-client-id
GOOGLE_SERVER_CLIENT_ID=op://Relay Deploy/app-config/google-server-client-id

# Non-secret literals. The external TestFlight group, and whether to distribute to it at all
# (only the literal `false` skips external distribution).
BETA_GROUP=Beta
TESTFLIGHT_EXTERNAL=true

# Android / Google Play (RLY-103): uncomment these once the upload keystore and the Play
# service-account key exist as `android-upload-keystore` and `play-store` items in the vault.
# Until then bin/deploy_android.sh skips the Play deploy cleanly.
# ANDROID_KEYSTORE_BASE64=op://Relay Deploy/android-upload-keystore/keystore-base64
# ANDROID_KEYSTORE_PASSWORD=op://Relay Deploy/android-upload-keystore/store-password
# ANDROID_KEY_PASSWORD=op://Relay Deploy/android-upload-keystore/key-password
# ANDROID_KEY_ALIAS=op://Relay Deploy/android-upload-keystore/key-alias
# PLAY_STORE_CONFIG_JSON_BASE64=op://Relay Deploy/play-store/json-key-base64
