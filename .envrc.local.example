# Copy this file to `.envrc.local` (gitignored) and fill in secrets as they arise.
# Non-secret project vars live in `.envrc`. direnv loads .envrc.local automatically
# (.envrc sources it); run `direnv allow` after editing. These end up in your
# environment for `mix`, `make`, and `iex`.

# --- Secrets (add as features need them, e.g. OAuth, external AI providers) ---
# Google OAuth (MMF 01). Create an OAuth client in Google Cloud Console with
# authorized redirect URIs:
#   http://localhost:4003/auth/google/callback
#   https://relayboard.fly.dev/auth/google/callback
# In prod, set the same two values with `fly secrets set`.
# export GOOGLE_CLIENT_ID=...
# export GOOGLE_CLIENT_SECRET=...

# --- Deploy (RE board's Deploy flow; runners inherit these from this direnv shell) ---
# Restart `relay start` after changing any of them.
# export FLY_API_TOKEN=…                      # fly tokens create deploy -a relayboard
# iOS / TestFlight (only needed once a card touches flutter/):
# export APP_STORE_CONNECT_PRIVATE_KEY=…      # .p8 PEM text or its base64
# export APP_STORE_CONNECT_KEY_ID=…
# export APP_STORE_CONNECT_ISSUER_ID=…
# export MATCH_PASSWORD=…
# export MATCH_GIT_BASIC_AUTHORIZATION=…      # base64 of "user:token" for the match certs repo
# export FASTLANE_USER=…                      # Apple ID
# export FASTLANE_PASSWORD=…                  # its app-specific password
# export RELAY_BASE_URL=https://relayboard.fly.dev
# export GOOGLE_IOS_CLIENT_ID=…
# export GOOGLE_SERVER_CLIENT_ID=…
# Optional: BETA_GROUP (default Beta), TESTFLIGHT_EXTERNAL=false to skip external testers.
# Android / Play (RLY-103) skips cleanly until all five exist:
# export ANDROID_KEYSTORE_BASE64=… ANDROID_KEYSTORE_PASSWORD=… ANDROID_KEY_PASSWORD=…
# export ANDROID_KEY_ALIAS=… PLAY_STORE_CONFIG_JSON_BASE64=…
