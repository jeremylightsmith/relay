<Layouts.flash_group flash={@flash} />

<div class="w-full overflow-x-clip">
  <%!-- NAV --%>
  <header class="sticky top-0 z-20 border-b border-base-300 bg-base-100/85 backdrop-blur-md">
    <nav class="mx-auto flex h-[62px] max-w-[1120px] items-center gap-4 px-4 sm:gap-7 sm:px-8">
      <a href="#top" class="flex items-center gap-2">
        <.hamaca_mark class="h-[22px]" />
        <span class="hidden text-base font-semibold tracking-[-0.02em] sm:inline">Hamaca</span>
      </a>
      <div class="hidden items-center gap-[22px] text-[13.5px] text-base-content/70 md:flex">
        <a href="#review" class="hover:text-primary">Review by looking</a>
        <a href="#how" class="hover:text-primary">How it works</a>
        <a href="#built" class="hover:text-primary">Built by Hamaca</a>
        <a href="/#pricing" class="hover:text-primary">Pricing</a>
      </div>
      <span class="flex-1"></span>
      <a
        id="nav-github"
        href={github_url()}
        aria-label="Hamaca on GitHub"
        class="flex items-center gap-1.5 text-[13.5px] text-base-content/70 hover:text-primary"
      >
        <.github_mark class="size-[18px]" />
        <span class="hidden lg:inline">GitHub</span>
      </a>
      <Layouts.theme_toggle />
      <a
        href={~p"/auth/google"}
        class="hidden text-[13.5px] text-base-content/70 hover:text-primary sm:inline"
      >
        Sign in
      </a>
      <a id="nav-start" href={~p"/auth/google"} class="btn btn-primary btn-sm rounded-lg">
        Start your board
      </a>
    </nav>
  </header>

  <%!-- HERO --%>
  <section
    id="top"
    class="mx-auto grid max-w-[1120px] grid-cols-1 items-center gap-6 px-4 pb-6 pt-12 sm:px-8 md:grid-cols-[1fr_1.05fr] md:gap-4 md:pt-16"
  >
    <div class="text-center md:text-left">
      <h1 class="mb-5 text-[44px] font-semibold leading-[1.02] tracking-[-0.035em] md:text-[60px]">
        <span class="mb-1 flex items-center justify-center gap-3 text-secondary md:justify-start">
          <.hamaca_mark class="h-[40px] md:h-[52px]" />Hamaca:
        </span>
        Hammock Driven Development.
      </h1>
      <p class="mx-auto mb-8 max-w-[520px] text-lg leading-relaxed text-base-content/70 md:mx-0">
        Your agents become a factory you can see at a glance. Your phone lights up only when a
        decision is yours, and what you approve is design docs, mockups and screenshots. Ship
        more ideas than you have hours, from anywhere.
      </p>
      <div class="mb-4 flex flex-wrap items-center justify-center gap-3 md:justify-start">
        <a href={~p"/auth/google"} id="google-signin" class="btn btn-primary">
          Start your board
        </a>
        <a id="hero-watch" href={~p"/board/relay/public"} class="btn btn-outline gap-2">
          <span
            class="size-2 rounded-full bg-secondary"
            style="animation:relaypulse 1.4s ease-in-out infinite;"
          >
          </span>
          Watch Hamaca build itself
        </a>
      </div>
      <p class="mb-2 text-xs text-base-content/55">
        Free for one board. Open source (MIT). Works with Claude Code.
      </p>
      <p class="text-xs text-base-content/55">
        By continuing you agree to our <.link navigate={~p"/terms"} class="link">Terms</.link>
        and <.link navigate={~p"/privacy"} class="link">Privacy Policy</.link>.
      </p>
    </div>

    <%!-- The picture slot: swappable for a raster image without touching this template --%>
    <.landing_hero_visual />
  </section>

  <%!-- REVIEW BY LOOKING — the board, then the two screens its lit cards open --%>
  <section id="review" class="mx-auto max-w-[1120px] px-4 pb-16 pt-8 sm:px-8">
    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between md:gap-10">
      <div>
        <div class="mb-3.5 font-mono text-xs font-semibold tracking-[0.08em] text-success">
          REVIEW BY LOOKING
        </div>
        <h2 class="max-w-[640px] text-[32px] font-semibold leading-tight tracking-[-0.025em] md:text-[38px]">
          Make your life easier. Approve design docs, mockups and screenshots, not code.
        </h2>
      </div>
      <p class="max-w-[420px] text-base leading-relaxed text-base-content/70">
        The board shows every card and whose move it is. When a card comes back to you, open it.
        A design card opens with its mockups. A built card opens with screenshots of the running app.
      </p>
    </div>

    <.landing_board />

    <%!-- The arrows (lg+): each lit card drops into the screen it opens. Same grid as the board. --%>
    <div
      class="hidden h-[78px] grid-cols-[1fr_1.6fr_1fr_1fr_0.8fr] gap-2.5 px-4 lg:grid"
      aria-hidden="true"
    >
      <span></span>
      <span class="grid grid-cols-2">
        <span></span>
        <span class="relative flex flex-col items-center">
          <span class="w-0 flex-1 border-l-2 border-dashed border-warning"></span>
          <svg viewBox="0 0 16 10" class="h-2.5 w-4 shrink-0 fill-warning">
            <path d="M0 0 L16 0 L8 10 Z" />
          </svg>
          <span class="absolute right-[calc(50%+14px)] top-1/2 -translate-y-1/2 whitespace-nowrap rounded-full border border-warning/40 bg-base-100 px-3 py-1 text-[12px] font-medium shadow-sm">
            Opens with the mockups
          </span>
        </span>
      </span>
      <span></span>
      <span class="relative flex flex-col items-center">
        <span class="w-0 flex-1 border-l-2 border-dashed border-warning"></span>
        <svg viewBox="0 0 16 10" class="h-2.5 w-4 shrink-0 fill-warning">
          <path d="M0 0 L16 0 L8 10 Z" />
        </svg>
        <span class="absolute right-[calc(50%+14px)] top-1/2 -translate-y-1/2 whitespace-nowrap rounded-full border border-warning/40 bg-base-100 px-3 py-1 text-[12px] font-medium shadow-sm">
          Opens with screenshots
        </span>
      </span>
      <span></span>
    </div>

    <div class="grid grid-cols-1 gap-2.5 lg:grid-cols-[1fr_1.6fr_1fr_1fr_0.8fr] lg:px-4">
      <%!-- Below lg the arrows become labels above each screen --%>
      <div class="mt-6 flex items-center gap-2 lg:hidden">
        <svg viewBox="0 0 16 10" class="h-2.5 w-4 shrink-0 fill-warning" aria-hidden="true">
          <path d="M0 0 L16 0 L8 10 Z" />
        </svg>
        <span class="rounded-full border border-warning/40 bg-base-100 px-3 py-1 text-[12px] font-medium shadow-sm">
          The Design card opens with the mockups
        </span>
      </div>

      <.landing_browser />

      <div class="mt-6 flex items-center gap-2 lg:hidden">
        <svg viewBox="0 0 16 10" class="h-2.5 w-4 shrink-0 fill-warning" aria-hidden="true">
          <path d="M0 0 L16 0 L8 10 Z" />
        </svg>
        <span class="rounded-full border border-warning/40 bg-base-100 px-3 py-1 text-[12px] font-medium shadow-sm">
          The Review card opens with screenshots
        </span>
      </div>

      <.landing_phone />
    </div>

    <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-3">
      <div class="rounded-[14px] border border-base-300 p-4">
        <div class="mb-1 font-mono text-[11px] font-semibold tracking-wider text-secondary">
          DESIGN REVIEW
        </div>
        <div class="text-[14px] font-medium">
          Mockups land on the card before a line of code is written.
        </div>
      </div>
      <div class="rounded-[14px] border border-base-300 p-4">
        <div class="mb-1 font-mono text-[11px] font-semibold tracking-wider text-secondary">
          REVIEW
        </div>
        <div class="text-[14px] font-medium">
          Screenshots of the running app and a short summary, not a diff.
        </div>
      </div>
      <div class="rounded-[14px] border border-base-300 p-4">
        <div class="mb-1 font-mono text-[11px] font-semibold tracking-wider text-primary">
          YOUR CALL
        </div>
        <div class="text-[14px] font-medium">
          Approve, or send it back with a note. The next round starts from what you said.
        </div>
      </div>
    </div>
  </section>

  <%!-- THE SILENT STALL --%>
  <section
    id="problem"
    class="mx-auto grid max-w-[1120px] grid-cols-1 items-center gap-8 px-4 py-16 sm:px-8 md:grid-cols-2 md:gap-14"
  >
    <div>
      <div class="mb-3.5 font-mono text-xs font-semibold tracking-[0.08em] text-warning">
        THE SILENT STALL
      </div>
      <h2 class="mb-3.5 text-[30px] font-semibold leading-tight tracking-[-0.02em]">
        It finished an hour ago. Nothing told you.
      </h2>
      <p class="mb-4 text-base leading-relaxed text-base-content/70">
        Agents are cheap now. Coordinating them isn't. Five terminals, five worktrees, and the only
        way to know where each one is: read it all again. Ten minutes to rebuild context, every switch.
      </p>
      <p class="text-base leading-relaxed text-base-content/70">
        So you can't step away. And when you do, you feel guilty about the agents sitting idle.
        You wanted to be a builder. You became a babysitter.
      </p>
    </div>
    <.landing_terminals />
  </section>

  <%!-- GUIDE: built by Hamaca --%>
  <section id="built" class="border-y border-base-300 bg-base-200">
    <div class="mx-auto max-w-[1120px] px-4 py-16 sm:px-8">
      <div class="mb-3.5 font-mono text-xs font-semibold tracking-[0.08em] text-secondary">
        WE'VE BEEN THERE
      </div>
      <h2 class="mb-3.5 max-w-[700px] text-[32px] font-semibold leading-tight tracking-[-0.025em]">
        We got tired of pacing between terminals too.
      </h2>
      <p class="mb-10 max-w-[600px] text-base leading-relaxed text-base-content/70">
        Asking each one "are you done yet?" So we built the board we wanted, and then let it build itself.
      </p>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-[14px] border border-base-300 bg-base-100 p-6">
          <div class="mb-3 font-mono text-[11px] font-semibold tracking-wider text-secondary">
            BUILT BY HAMACA
          </div>
          <h3 class="mb-2 text-base font-semibold">Its own board ships it.</h3>
          <p class="mb-4 text-[13.5px] leading-relaxed text-base-content/70">
            Hamaca's board plans, codes, reviews, tests and ships Hamaca. This page was a card on it.
          </p>
          <div class="flex items-center gap-2 rounded-[9px] border border-base-300 border-l-[3px] border-l-success bg-base-200 p-2.5">
            <span class="font-mono text-[11px] text-base-content/60">RE476</span>
            <span class="truncate text-[12px] font-medium">Hamaca landing page</span>
            <span class="ml-auto font-mono text-[10px] text-success">SHIPPED</span>
          </div>
          <a
            id="built-watch"
            href={~p"/board/relay/public"}
            class="link link-primary mt-4 inline-block text-[13px]"
          >
            Watch it build itself →
          </a>
        </div>
        <div class="rounded-[14px] border border-base-300 bg-base-100 p-6">
          <div class="mb-3 font-mono text-[11px] font-semibold tracking-wider text-warning">
            JIDOKA · ANDON
          </div>
          <h3 class="mb-2 text-base font-semibold">The light comes on when it needs you.</h3>
          <p class="mb-4 text-[13.5px] leading-relaxed text-base-content/70">
            Borrowed from Toyota: machines that stop and call a person (<i>jidoka</i>), and the light on the line that says "I need you" (<i>andon</i>).
          </p>
          <div class="flex items-center gap-3 rounded-[9px] border border-base-300 bg-base-200 p-2.5">
            <span class="size-2 rounded-full bg-secondary/40"></span>
            <span class="size-2 rounded-full bg-secondary/40"></span>
            <span class="size-2.5 rounded-full bg-warning" style={andon_glow_style()}></span>
            <span class="size-2 rounded-full bg-secondary/40"></span>
            <span class="size-2 rounded-full bg-secondary/40"></span>
            <span class="ml-auto font-mono text-[10.5px] text-base-content/60">
              1 of 5 needs you
            </span>
          </div>
        </div>
        <div class="rounded-[14px] border border-base-300 bg-base-100 p-6">
          <div class="mb-3 font-mono text-[11px] font-semibold tracking-wider text-primary">
            FLOW METRICS
          </div>
          <h3 class="mb-2 text-base font-semibold">Proof the factory gets better.</h3>
          <p class="mb-4 text-[13.5px] leading-relaxed text-base-content/70">
            Lead time, flow efficiency and rework, on every board. Tune the line, then watch the numbers move.
          </p>
          <div class="rounded-[9px] border border-base-300 bg-base-200 p-2.5">
            <div class="mb-1.5 flex items-baseline justify-between font-mono text-[10.5px] text-base-content/60">
              <span>EXAMPLE BOARD · LEAD TIME · 8 WKS</span>
              <span class="text-success">↓ 61%</span>
            </div>
            <div class="flex h-10 items-end gap-1">
              <span
                :for={height <- [100, 88, 92, 70, 62, 55, 44, 39]}
                class={[
                  "flex-1 rounded-sm",
                  if(height == 39, do: "bg-primary", else: "bg-primary/70")
                ]}
                style={"height:#{height}%"}
              >
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%!-- HOW IT WORKS --%>
  <section id="how" class="mx-auto max-w-[1120px] px-4 pb-6 pt-16 sm:px-8">
    <div class="mb-3.5 font-mono text-xs font-semibold tracking-[0.08em] text-primary">
      HOW IT WORKS
    </div>
    <h2 class="mb-8 max-w-[680px] text-[32px] font-semibold leading-tight tracking-[-0.025em]">
      Stop babysitting agents. Start running a factory.
    </h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="flex flex-col rounded-[14px] border border-base-300 bg-base-200 p-6">
        <div class="mb-4 flex size-8 items-center justify-center rounded-full bg-primary font-mono text-sm font-semibold text-primary-content">
          1
        </div>
        <h3 class="mb-2 text-base font-semibold">Connect your repo.</h3>
        <p class="mb-5 text-[13.5px] leading-relaxed text-base-content/70">
          Install Hamaca, and Claude Code wires the board to your project.
        </p>
        <div
          class="mt-auto rounded-[9px] p-3 font-mono text-[11.5px] text-neutral-content/85"
          style="background:var(--color-neutral);"
        >
          <span class="text-neutral-content/50">$</span>
          curl -fsSL hamaca.app/b/recipes/install | sh<br />
          <span class="text-success">✓</span>
          board wired to ~/recipes
        </div>
      </div>
      <div class="flex flex-col rounded-[14px] border border-base-300 bg-base-200 p-6">
        <div class="mb-4 flex size-8 items-center justify-center rounded-full bg-primary font-mono text-sm font-semibold text-primary-content">
          2
        </div>
        <h3 class="mb-2 text-base font-semibold">Draw your line.</h3>
        <p class="mb-5 text-[13.5px] leading-relaxed text-base-content/70">
          Decide which stages are yours (approve, answer) and which belong to agents (plan, build, review, test).
        </p>
        <.landing_stage_strip />
      </div>
      <div class="flex flex-col rounded-[14px] border border-base-300 bg-base-200 p-6">
        <div class="mb-4 flex size-8 items-center justify-center rounded-full bg-primary font-mono text-sm font-semibold text-primary-content">
          3
        </div>
        <h3 class="mb-2 text-base font-semibold">
          Drop in ideas. Answer when the light comes on.
        </h3>
        <p class="mb-5 text-[13.5px] leading-relaxed text-base-content/70">
          Approve, send it back with a note, or answer a question, from your phone.
        </p>
        <div class="mt-auto flex flex-col gap-2 rounded-[9px] border border-warning/40 bg-warning/10 p-3">
          <span class="font-mono text-[10px] font-semibold tracking-[0.05em] text-warning">
            AGENT ASKED
          </span>
          <span class="text-[12.5px] leading-snug text-base-content/80">
            Cache map tiles or vectors for offline mode?
          </span>
          <div class="flex gap-1.5">
            <span class="rounded-md bg-base-100 px-2 py-1 text-[11.5px] font-medium">Tiles</span>
            <span class="rounded-md bg-base-100 px-2 py-1 text-[11.5px] font-medium">
              Vectors
            </span>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-3 rounded-[14px] border border-base-300 p-5 sm:grid-cols-3">
      <div
        :for={
          promise <- [
            "Nothing ships without a person saying so.",
            "Agents ask instead of guessing.",
            "You can always see whose move it is."
          ]
        }
        class="flex items-start gap-2.5"
      >
        <span class="mt-0.5 text-success">✓</span>
        <span class="text-[14px] font-medium">{promise}</span>
      </div>
    </div>
  </section>

  <%!-- STAKES / SUCCESS --%>
  <section
    id="stakes"
    class="mx-auto grid max-w-[1120px] grid-cols-1 gap-4 px-4 py-14 sm:px-8 md:grid-cols-2"
  >
    <div class="rounded-[14px] border border-base-300 bg-base-100 p-7">
      <div class="mb-3.5 font-mono text-xs font-semibold tracking-[0.08em] text-base-content/55">
        WITHOUT A LINE
      </div>
      <h2 class="mb-5 text-[24px] font-semibold leading-tight tracking-[-0.02em]">
        What babysitting costs.
      </h2>
      <ul class="flex flex-col gap-3.5 text-[14.5px] leading-snug text-base-content/75">
        <li
          :for={
            cost <- [
              "Agents finish at 9pm and sit idle until morning.",
              "Code merges that no human really looked at.",
              "Burnout from juggling terminals and context.",
              "Your best ideas die in the backlog."
            ]
          }
          class="flex gap-3"
        >
          <span class="mt-1.5 size-2 shrink-0 rounded-full bg-base-content/30"></span>{cost}
        </li>
      </ul>
    </div>
    <div class="rounded-[14px] border border-success/40 bg-success/10 p-7">
      <div class="mb-3.5 font-mono text-xs font-semibold tracking-[0.08em] text-success">
        FROM THE HAMMOCK
      </div>
      <h2 class="mb-5 text-[24px] font-semibold leading-tight tracking-[-0.02em]">
        Ship from anywhere. Decide from your phone.
      </h2>
      <ul class="flex flex-col gap-3.5 text-[14.5px] leading-snug text-base-content/80">
        <li
          :for={
            win <- [
              "Ideas get built about as fast as you can describe them.",
              "Five projects at once, because context is one glance.",
              "Ship from the hammock, the trail, or the school pickup line.",
              "The factory needs you less every week, and you can prove it."
            ]
          }
          class="flex gap-3"
        >
          <span class="mt-0.5 text-success">✓</span>{win}
        </li>
      </ul>
    </div>
  </section>

  <%!-- TRANSFORMATION --%>
  <section
    id="transformation"
    class="mx-auto max-w-[1120px] px-4 pb-10 pt-4 text-center sm:px-8"
  >
    <div class="mx-auto flex max-w-[760px] flex-col items-center gap-5 sm:flex-row sm:justify-center sm:gap-8">
      <div class="flex flex-col items-center gap-1.5">
        <span class="font-mono text-[11px] tracking-wider text-base-content/50">BEFORE</span>
        <span class="text-[22px] font-semibold text-base-content/45 line-through decoration-base-content/30">
          the babysitter
        </span>
      </div>
      <span class="text-2xl text-secondary">→</span>
      <div class="flex flex-col items-center gap-1.5">
        <span class="font-mono text-[11px] tracking-wider text-primary">AFTER</span>
        <span class="flex items-center gap-2 text-[22px] font-semibold">
          the one in the hammock <.hamaca_mark class="h-[22px]" />
        </span>
      </div>
    </div>
    <p class="mx-auto mt-5 max-w-[520px] text-base leading-relaxed text-base-content/70">
      You stop watching the work and start directing it, calmly, from wherever you are.
      Making things is fun again, and what comes out is real software.
    </p>
  </section>

  <%!-- PRICING --%>
  <section id="pricing" class="mx-auto max-w-[1120px] px-4 py-14 sm:px-8">
    <div class="rounded-[20px] border border-base-300 bg-base-100 px-5 py-10 sm:px-10">
      <div class="text-center font-mono text-xs font-semibold tracking-[0.08em] text-primary">
        PRICING
      </div>
      <h2 class="mx-auto mt-2 max-w-xl text-center text-[28px] font-semibold leading-tight tracking-[-0.02em]">
        Start free. Pay when you want more boards.
      </h2>
      <div class="mx-auto mt-8 grid max-w-[1000px] gap-4 md:grid-cols-3">
        <div id="pricing-self-host" class="card border border-base-300 bg-base-100 p-6">
          <div class="font-mono text-[11px] text-base-content/65">SELF-HOST</div>
          <div class="mt-2 flex flex-wrap items-baseline gap-1">
            <span class="text-4xl font-semibold">Free</span>
            <span class="text-sm text-base-content/65">forever · MIT</span>
          </div>
          <ul class="mt-4 space-y-2 text-sm text-base-content/75">
            <li>✓ Every feature. No "enterprise edition."</li>
            <li>✓ Your server, your database, your keys</li>
            <li>✓ Unlimited boards</li>
            <li class="text-base-content/55">
              — You run upgrades, backups and push certificates
            </li>
          </ul>
          <span class="flex-1"></span>
          <a
            id="pricing-self-host-cta"
            class="btn btn-outline mt-6"
            href={github_url() <> "#readme"}
          >
            Self-host from the README →
          </a>
        </div>
        <div id="pricing-free" class="card border-2 border-primary bg-base-100 p-6">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] text-primary">HAMACA CLOUD · FREE</span>
            <span class="badge badge-primary badge-sm">No card</span>
          </div>
          <div class="mt-2 flex items-baseline gap-1">
            <span class="text-4xl font-semibold">$0</span>
            <span class="text-sm text-base-content/65">forever</span>
          </div>
          <ul class="mt-4 space-y-2 text-sm text-base-content/75">
            <li>✓ <b>One board</b>, every feature</li>
            <li>✓ Agent runs, flows, iOS & Android push</li>
            <li>✓ Invite your team. Members are free.</li>
            <li>✓ We run upgrades and backups</li>
          </ul>
          <span class="flex-1"></span>
          <a id="pricing-free-cta" class="btn btn-primary mt-6" href={~p"/auth/google"}>
            Start your board, no card →
          </a>
        </div>
        <div id="pricing-cloud" class="card border border-base-300 bg-base-100 p-6">
          <div class="font-mono text-[11px] text-base-content/65">HAMACA CLOUD</div>
          <div class="mt-2 flex items-baseline gap-1">
            <span class="text-4xl font-semibold">$20</span>
            <span class="text-sm text-base-content/65">/ month</span>
          </div>
          <ul class="mt-4 space-y-2 text-sm text-base-content/75">
            <li>✓ Everything in Free</li>
            <li>✓ <b>Unlimited boards</b></li>
            <li>✓ Cancel anytime. You drop to Free; nothing is deleted.</li>
          </ul>
          <span class="flex-1"></span>
          <a id="pricing-cloud-cta" class="btn btn-outline mt-6" href={~p"/auth/google"}>
            Start free, upgrade anytime →
          </a>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-xl text-center text-xs text-base-content/60">
        Hamaca is open source under the MIT license. Your $20 pays for hosting and funds the project. Monthly only for now, no refunds.
        <a id="pricing-billing-docs" href={~p"/docs/billing"} class="link">How billing works →</a>
      </p>
    </div>
  </section>

  <%!-- FINAL CTA (deliberately fixed-dark in both themes) --%>
  <section id="cta" class="mx-auto max-w-[1120px] px-4 pb-20 pt-8 sm:px-8">
    <div
      class="relative overflow-hidden rounded-[20px] px-6 py-14 text-center sm:px-10"
      style="background:var(--color-neutral);"
    >
      <div class="mb-5 flex justify-center">
        <.hamaca_mark class="h-[44px]" />
      </div>
      <h2 class="mx-auto mb-3.5 max-w-[560px] text-[34px] font-semibold leading-tight tracking-[-0.025em] text-neutral-content">
        Get in the hammock.
      </h2>
      <p class="mx-auto mb-7 max-w-[480px] text-base leading-relaxed text-neutral-content/70">
        Connect a repo, draw your line, drop in an idea. The light comes on when it needs you.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a id="cta-start" href={~p"/auth/google"} class="btn btn-primary">Start your board →</a>
        <a
          id="cta-watch"
          href={~p"/board/relay/public"}
          class="btn btn-ghost text-neutral-content hover:bg-neutral-content/10"
        >
          Watch Hamaca build itself
        </a>
      </div>
      <p class="mx-auto mt-6 max-w-[600px] text-[13px] leading-relaxed text-neutral-content/60">
        Open source under the MIT license. Rather run it yourself?
        <a
          href={github_url() <> "#readme"}
          class="link text-neutral-content/85 hover:text-neutral-content"
        >
          Self-host from the README →
        </a>
      </p>
    </div>
  </section>

  <%!-- FOOTER --%>
  <footer class="border-t border-base-300">
    <div class="mx-auto flex max-w-[1120px] flex-wrap items-center gap-3 px-4 py-7 sm:px-8">
      <.hamaca_mark class="h-[18px]" />
      <span class="text-sm font-semibold tracking-[-0.01em]">Hamaca</span>
      <span class="flex-1"></span>
      <span class="font-mono text-xs text-base-content/65">
        hammock driven development · open source (MIT) · © 2026
      </span>
      <nav class="flex items-center gap-4 text-xs text-base-content/65">
        <.link navigate={~p"/terms"} class="link link-hover">Terms</.link>
        <.link navigate={~p"/privacy"} class="link link-hover">Privacy</.link>
        <a href="/#pricing" class="link link-hover">Pricing</a>
        <.link navigate={~p"/docs"} class="link link-hover">Docs</.link>
        <a href={github_url()} class="link link-hover inline-flex items-center gap-1">
          <.github_mark class="size-3.5" /> GitHub
        </a>
      </nav>
    </div>
    <div class="mx-auto max-w-[1120px] px-4 pb-7 sm:px-8">
      <p id="photo-credit" class="text-xs text-base-content/55">
        Recipe photo: “<a
          href="https://commons.wikimedia.org/wiki/File:Lemon_Spaghetti_(14179778117).jpg"
          class="link link-hover"
        >Lemon Spaghetti</a>” by Luca Nebuloni,
        <a href="https://creativecommons.org/licenses/by/2.0/" class="link link-hover">
          CC BY 2.0
        </a>
      </p>
    </div>
  </footer>
</div>
