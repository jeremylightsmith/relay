<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main id="oauth-consent" class="flex flex-col items-center justify-center px-4 py-10">
    <div class="mb-5 flex items-center gap-3">
      <img src={~p"/images/logo_transparent_128.png"} width="36" alt={Hamaca.Brand.name()} />
      <.icon name="hero-arrows-right-left" class="size-5 text-base-content/45" />
      <span
        id="consent-ai-mark"
        class="flex size-9 items-center justify-center rounded-xl bg-secondary/15 text-secondary"
      >
        <.icon name="hero-sparkles" class="size-5" />
      </span>
    </div>

    <section class="card w-full max-w-md border border-base-300 bg-base-100 p-6">
      <h1 class="text-center text-xl font-semibold tracking-tight">Connect Claude to Hamaca?</h1>
      <p class="mt-1 text-center text-sm text-base-content/65">
        <span id="consent-client-name" class="font-medium text-base-content">
          {client_label(@client_name)}
        </span>
        is asking to use your Hamaca account.
      </p>

      <div id="consent-account" class="mt-5 flex items-center gap-3 rounded-box bg-base-200 p-3">
        <.avatar
          src={@user.avatar_url}
          name={@user.name}
          email={@user.email}
          size={32}
          tint={:role}
        />
        <div class="min-w-0 flex-1 text-sm">
          <div class="font-medium">{@user.name || @user.email}</div>
          <div class="truncate text-xs text-base-content/65">
            Signed in with {provider_label(@user.provider)}
          </div>
        </div>
        <.link
          id="consent-not-you"
          href={@not_you_path}
          method="delete"
          class="link text-xs text-base-content/65"
        >
          Not you?
        </.link>
      </div>

      <div class="mt-5 text-xs font-semibold text-base-content/65">CLAUDE WILL BE ABLE TO</div>
      <ul id="consent-capabilities" class="mt-2 space-y-2.5 text-sm">
        <li :for={item <- @capabilities.can} class="flex items-start gap-2.5">
          <.icon name={item.icon} class="size-4 mt-0.5 shrink-0 text-base-content/65" />
          <span><span class="font-medium">{item.title}</span>{item.detail}</span>
        </li>
      </ul>

      <% {before, emphasis, rest} = cannot_parts(@capabilities.cannot) %>
      <div
        id="consent-cannot"
        class="mt-3 flex items-start gap-2.5 rounded-box border border-base-300 p-3 text-xs text-base-content/65"
      >
        <.icon name="hero-no-symbol" class="size-4 shrink-0" />
        <span>
          {before}<span :if={emphasis} class="font-medium text-base-content">{emphasis}</span>{rest}
        </span>
      </div>

      <form id="consent-form" method="post" action={~p"/oauth/authorize"} class="mt-5 flex gap-2">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input :for={{name, value} <- @hidden} type="hidden" name={name} value={value} />
        <button
          id="consent-cancel"
          type="submit"
          name="decision"
          value="cancel"
          class="btn btn-ghost flex-1"
        >
          Cancel
        </button>
        <button
          id="consent-allow"
          type="submit"
          name="decision"
          value="allow"
          class="btn btn-primary flex-1"
        >
          Allow
        </button>
      </form>
    </section>
  </main>
</Layouts.app>
