#!/usr/bin/env bash
# @describe Run a command against your local development checkout.
#
# direnv puts bin/ on your PATH inside the project, so this is a bare `dev` command.
# The sibling of `prod`: same shape, but everything here runs locally and touches nothing
# deployed.

set -euo pipefail

# Adding a command
#
#   Commands are declared with argc (https://github.com/sigoden/argc). A `# @cmd` comment
#   above a function makes that function a subcommand, and argc builds `--help` out of
#   these comments — there is no list to register it in.
#
#   argc is pinned in mise.toml, so `mise install` provides it.

# The repo root is one level up from bin/. cd there so mix runs against the project.
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# @cmd Run the full precommit gate.
#
# Compile (warnings as errors), format with Styler, credo --strict, sobelow, deps.audit and
# the test suite. Required on every development cycle — see AGENTS.md.
precommit() {
  exec mix precommit
}

# @cmd Run the test suite.
#
# The :playwright tier is excluded — `mix test.browser` runs it.
#
# (Yes, this shadows the `test` builtin. Only inside this file, which uses `[[ ]]` throughout.)
# @arg args* Extra arguments passed through to `mix test`.
test() {
  exec mix test ${argc_args[@]+"${argc_args[@]}"}
}

# @cmd Start the app with an IEx shell attached.
#
# http://localhost:4003 (PORT overrides it). Ctrl-C twice to stop.
serve() {
  exec iex -S mix phx.server
}

# @cmd Create the public example boards (RE444) in your dev database.
#
# Idempotent: an example board that already exists is skipped. --reset recreates them.
# @option --owner The board owner's email (default: your git user.email).
# @flag --reset Delete and recreate the example boards.
seed-examples() {
  local args=(--owner "${argc_owner:-$(git config user.email)}")
  if [[ "${argc_reset:-0}" == 1 ]]; then
    args+=(--reset)
  fi
  exec mix hamaca.examples.seed "${args[@]}"
}

# @cmd Install zsh tab completion for prod and dev.
#
# Writes a `#compdef` file into a completions directory already on your $fpath (~/.zsh by
# default — the line `fpath=(~/.zsh $fpath)` in .zshrc is what puts it there). compinit picks
# it up in your next shell.
#
# Run this once. The subcommand list is read out of the scripts live at completion time, so
# adding a `# @cmd` later needs no regeneration — only renaming a script does.
# @option --dir=~/.zsh Completions directory on your $fpath.
# @flag --print Write the script to stdout instead of installing it.
completions() {
  local dir="${argc_dir/#\~/$HOME}" body file

  # argc emits a `source <(argc --argc-completions ...)` script meant to be sourced. An fpath
  # file is autoloaded and *called* instead, so keep its function definitions, drop its
  # trailing compdef, and invoke the completer at the end under a `#compdef` tag compinit can
  # read. Delete from the `compdef` line to EOF: argc wraps that statement over two lines.
  body="$(argc --argc-completions zsh prod dev | sed '/^compdef /,$d')"
  body="#compdef prod dev
# Generated by \`dev completions\` — regenerate rather than editing by hand.
$body
_argc_completer \"\$@\""

  if [[ "${argc_print:-0}" == 1 ]]; then
    echo "$body"
    return 0
  fi

  [[ -d "$dir" ]] || {
    echo "$dir does not exist. Create it and add it to \$fpath in .zshrc:" >&2
    echo "  fpath=($dir \$fpath)   # before 'autoload -Uz compinit && compinit'" >&2
    exit 1
  }

  file="$dir/_relay_envs"
  echo "$body" > "$file"
  echo "Wrote $file"
  echo "Open a new shell (or run 'rm -f ~/.zcompdump; compinit') and try: prod <TAB>"
}

command -v argc >/dev/null || {
  echo "argc not found on PATH. It is pinned in mise.toml — run 'mise install'." >&2
  exit 1
}

eval "$(argc --argc-eval "$0" "$@")"
