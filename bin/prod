#!/usr/bin/env bash
# @describe Run a command against production (Fly app: relayboard).
#
# direnv puts bin/ on your PATH inside the project, so this is a bare `prod` command.
# Its sibling is `dev`. `prod deploy_fly`, `prod deploy_ios` and `prod deploy_android` run the same
# bin/deploy_*.sh scripts as the board's Deploy stage.

set -euo pipefail

# Adding a command
#
#   Commands are declared with argc (https://github.com/sigoden/argc). A `# @cmd` comment
#   above a function makes that function a subcommand, and argc builds `--help` out of
#   these comments — there is no list to register it in. Flags work the same way:
#   `# @flag -y --yes  Some help text` becomes `$argc_yes` (set to 1) inside the function.
#
#   argc is pinned in mise.toml, so `mise install` provides it.

# The repo root is one level up from bin/. cd there so config-file paths (fly.toml) resolve.
cd "$(dirname "${BASH_SOURCE[0]}")/.."

ENV_NAME=production
APP=relayboard

# Check a tool is installed before we try to use it. $1 = binary, $2 = what to do about it.
need() {
  command -v "$1" >/dev/null || {
    echo "$1 not found on PATH. $2" >&2
    exit 1
  }
}

# Ask before doing something destructive. You type the environment's name, so muscle memory
# can't carry you through it. --yes skips it (for scripts).
confirm() {
  [[ "${argc_yes:-0}" == 1 ]] && return 0
  echo "About to $1"
  read -r -p "Type '$ENV_NAME' to continue: " answer
  [[ "$answer" == "$ENV_NAME" ]] || {
    echo "Aborted." >&2
    exit 1
  }
}

# @cmd Run any flyctl command against production.
#
# Everything after `fly` is handed to flyctl untouched, with `--app relayboard` appended.
# `prod fly status`, `prod fly secrets list`.
#
# The flag goes last so it wins over an `--app` you typed yourself. It is only appended when
# you are calling a subcommand: flyctl's root command has no `--app` flag, so adding it to
# `prod fly --help` or `prod fly --version` would turn them into an error.
# @arg args~ Passed to `flyctl` verbatim.
fly() {
  need flyctl "Install it and run 'fly auth login'."
  # ${a[@]+"${a[@]}"} rather than plain "${a[@]}": argc leaves argc_args undefined when no
  # extra arguments are given, and `set -u` on bash 3.2 (macOS /bin/bash) aborts on that.
  local args=(${argc_args[@]+"${argc_args[@]}"})
  case "${args[0]:-}" in
    "" | -*) exec flyctl ${args[@]+"${args[@]}"} ;;
    *) exec flyctl "${args[@]}" --app "$APP" ;;
  esac
}

# @cmd Tail the application logs.
#
# Extra arguments go to flyctl, so the usual filters still work: `prod logs --no-tail`.
# @arg args* Extra arguments passed through to `flyctl logs`.
logs() {
  need flyctl "Install it and run 'fly auth login'."
  exec flyctl logs --app "$APP" ${argc_args[@]+"${argc_args[@]}"}
}

# @cmd Open a shell on a running machine.
#
# This is a plain shell. For an IEx session attached to the running app, use `iex`.
# @arg args* Extra arguments passed through to `fly ssh console`.
console() {
  need flyctl "Install it and run 'fly auth login'."
  exec flyctl ssh console -a "$APP" ${argc_args[@]+"${argc_args[@]}"}
}

# @cmd Open an IEx shell attached to the running app.
#
# --pty is explicit because flyctl only allocates a terminal by default when no -C command
# is given, and IEx without one is unusable.
iex() {
  need flyctl "Install it and run 'fly auth login'."
  exec flyctl ssh console -a "$APP" --pty -C "/app/bin/relay remote"
}

# @cmd Create the public example boards (RE444) that don't exist yet.
#
# Runs Relay.Release.seed_examples/2 on the running node. Idempotent: an example board that
# already exists is skipped, so this is safe to re-run. --reset deletes and recreates all
# three, so it asks first.
#
# `rpc`, not `eval`: the seeder's broadcasts need the live app's PubSub. Prints the
# created/skipped summary, because `fly ssh console -C` exits 0 even when the remote command
# dies — no summary line means it failed.
# @option --owner The board owner's email (default: your git user.email).
# @flag --reset Delete and recreate the example boards.
# @flag -y --yes Skip the confirmation prompt (with --reset).
seed-examples() {
  need flyctl "Install it and run 'fly auth login'."
  local owner="${argc_owner:-$(git config user.email)}" reset=false
  # The email is spliced into Elixir source, so allow only plain address characters.
  [[ "$owner" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ ]] || {
    echo "'$owner' doesn't look like an email address. Pass --owner <email>." >&2
    exit 1
  }
  if [[ "${argc_reset:-0}" == 1 ]]; then
    confirm "delete and recreate the example boards on $ENV_NAME (Fly app: $APP)."
    reset=true
  fi
  local expr="IO.inspect(Relay.Release.seed_examples(\\\"$owner\\\", reset: $reset), label: \\\"Examples\\\")"
  flyctl ssh console -a "$APP" -C "/app/bin/relay rpc \"$expr\""
}

# @cmd Pull Pantry's and Streaks' stages and flows into their board templates.
#
# Reads the live example boards (Relay.Release.example_template_parts/1) and rewrites the
# "stages" and "flows" of docs/designs/templates/design-led.json (Pantry) and
# bare-minimum.json (Streaks) via bin/pull_demo_flows.py. Nodes lose any agent (`llm`), so they
# run on the new board's default. The picker copy, the template's agents, the example-board
# JSON under templates/examples/ and the boards' cards are left alone. Only touches local
# files, so there is nothing to confirm; review the diff, commit, and deploy to ship it.
#
# The parts come back on one `DEMO_PARTS {json}` line: `fly ssh console -C` exits 0 even when
# the remote command dies, so no such line means it failed. ~s()/~w() keep double quotes out of
# the expression, which is itself double-quoted for the remote command.
pull-demo-flows() {
  need flyctl "Install it and run 'fly auth login'."
  need python3 "Install Python 3."
  local expr='IO.puts(~s(DEMO_PARTS ) <> Jason.encode!(Relay.Release.example_template_parts(~w(design-led bare-minimum))))'
  local out parts
  out="$(flyctl ssh console -a "$APP" -C "/app/bin/relay rpc \"$expr\"")"
  parts="$(printf '%s\n' "$out" | tr -d '\r' | sed -n 's/^DEMO_PARTS //p')"
  [[ -n "$parts" ]] || {
    printf '%s\n' "$out" >&2
    echo "No DEMO_PARTS line in the output above, so nothing was written." >&2
    exit 1
  }
  printf '%s\n' "$parts" | python3 bin/pull_demo_flows.py docs/designs/templates

  if git diff --quiet -- docs/designs/templates; then
    echo "The templates already match Pantry and Streaks. Nothing to do."
    return
  fi
  git --no-pager diff --stat -- docs/designs/templates
  cat <<'EOF'

Next:
  1. Check the changes:
       git diff docs/designs/templates
  2. Check the templates and example boards still load (a stage or flow the example JSON
     names but the board no longer has fails here):
       mix test test/relay/boards_templates_test.exs test/relay/boards_template_export_test.exs test/relay/examples_test.exs
  3. Commit, push and merge to main.
  4. Deploy, so "New board" uses the new templates:
       prod deploy_fly
EOF
}

# Refuse a dirty tree (unless --dirty) and warn when HEAD isn't on origin/main. Every deploy
# ships HEAD: uncommitted changes would go out under a SHA that doesn't contain them.
check_head() {
  if [[ "${argc_dirty:-0}" != 1 ]] && ! git diff --quiet HEAD; then
    git --no-pager diff --stat HEAD >&2
    echo "Uncommitted changes to tracked files (above) would ship under HEAD's SHA. Commit or stash them, or pass --dirty." >&2
    exit 1
  fi
  if ! git merge-base --is-ancestor HEAD origin/main 2>/dev/null; then
    echo "Warning: HEAD isn't on origin/main (as last fetched). Push and merge first unless you mean to deploy a branch."
  fi
}

# @cmd Deploy HEAD to Fly and wait until the board serves it.
#
# Runs bin/deploy_fly.sh, the board's Deploy stage step: needs FLY_API_TOKEN (from
# .envrc.local), skips when HEAD is already live, and polls the live version until it is HEAD.
#
# Fly builds from this working tree but stamps HEAD's SHA, so uncommitted changes to tracked
# files would ship under a SHA that doesn't contain them: refused unless --dirty. A HEAD that
# isn't on origin/main (as last fetched) gets a warning, since the board deploys main.
# @flag --dirty Deploy even with uncommitted changes to tracked files.
# @flag -y --yes Skip the confirmation prompt.
deploy_fly() {
  need flyctl "Install it and run 'fly auth login'."
  check_head
  confirm "deploy $(git log -1 --format='%h %s' HEAD) to $ENV_NAME (Fly app: $APP)."
  exec bin/deploy_fly.sh
}

# @cmd Build HEAD and upload it to TestFlight.
#
# Runs `bin/deploy_ios.sh --head`, the board's Deploy stage iOS step, minus its "did the card
# touch flutter/?" check: validate, next build number, build + sign (read-only match), upload,
# then external distribution unless TESTFLIGHT_EXTERNAL=false. Needs the App Store Connect and
# match secrets from .envrc.local. Same --dirty / origin/main guards as deploy_fly.
# @flag --dirty Deploy even with uncommitted changes to tracked files.
# @flag -y --yes Skip the confirmation prompt.
deploy_ios() {
  need fastlane "Run 'mise install' in the repo."
  check_head
  confirm "upload $(git log -1 --format='%h %s' HEAD) to TestFlight."
  exec bin/deploy_ios.sh --head
}

# @cmd Build HEAD and upload it to Google Play's internal track.
#
# Runs `bin/deploy_android.sh --head`, the board's Deploy stage Android step, minus its "did the
# card touch flutter/?" check. Skips cleanly while the Android credentials aren't configured
# (RLY-103). Same --dirty / origin/main guards as deploy_fly.
# @flag --dirty Deploy even with uncommitted changes to tracked files.
# @flag -y --yes Skip the confirmation prompt.
deploy_android() {
  need fastlane "Run 'mise install' in the repo."
  check_head
  confirm "upload $(git log -1 --format='%h %s' HEAD) to Google Play internal testing."
  exec bin/deploy_android.sh --head
}

command -v argc >/dev/null || {
  echo "argc not found on PATH. It is pinned in mise.toml — run 'mise install'." >&2
  exit 1
}

eval "$(argc --argc-eval "$0" "$@")"
