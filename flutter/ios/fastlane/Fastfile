default_platform(:ios)

APP_IDENTIFIER = "com.jeremylightsmith.Relay"
TEAM_ID = "CR8KT24FBH"

# App Store Connect API key from FASTLANE_API_KEY_PATH (the raw .p8) plus the
# key id + issuer id, or nil when any is missing. (upload_to_testflight's
# api_key_path expects a JSON file, not a .p8 — building the key avoids that.)
def asc_api_key
  path = ENV["FASTLANE_API_KEY_PATH"]
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  return nil unless path && key_id && issuer_id

  app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: path)
end

# "What to Test": TESTFLIGHT_CHANGELOG, else the HEAD commit subject.
def testflight_changelog
  changelog = ENV["TESTFLIGHT_CHANGELOG"].to_s.strip
  changelog = last_git_commit[:message].to_s.lines.first.to_s.strip if changelog.empty?
  changelog = "Bug fixes and improvements." if changelog.empty?
  changelog
end

# External TestFlight group (created in App Store Connect). Empty counts as
# unset — GitHub passes an unset repo var as "".
def beta_group
  group = ENV["BETA_GROUP"].to_s.strip
  group.empty? ? "Beta" : group
end

# Runner deploys (bin/deploy_ios.sh sets RELAY_DEPLOY=1) use match exactly as CI does:
# read-only, never regenerating the distribution profile. A plain local run keeps forcing.
# (`setup_ci` stays CI-only: on a runner Mac it would replace the default keychain.)
def match_readonly?
  is_ci || ENV["RELAY_DEPLOY"] == "1"
end

platform :ios do
  desc "Sync certificates and provisioning profiles using Match"
  lane :sync_certificates do
    UI.important("🔐 Syncing certificates and provisioning profiles...")

    readonly = match_readonly?
    match(
      type: "appstore",
      readonly: readonly,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      force_for_new_devices: !readonly,
      verbose: true,
      force: !readonly
    )
    UI.success("✅ Certificates and profiles synced from Match!")
  end

  desc "Build IPA for App Store"
  lane :build_ipa do
    setup_ci if is_ci

    # BUILD_NUMBER is required.
    #   CI:    GitHub run number
    #   Local: set explicitly, e.g. BUILD_NUMBER=999 fastlane deploy
    build_num = ENV["BUILD_NUMBER"]
    if build_num.nil? || build_num.empty?
      UI.user_error!("❌ BUILD_NUMBER environment variable is required. Set it like: BUILD_NUMBER=123 fastlane deploy")
    end

    UI.important("🔢 Setting build number to: #{build_num}")
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: build_num
    )

    # Get Flutter dependencies and build (unsigned; fastlane signs below).
    sh("cd ../.. && flutter pub get")

    # Public app config baked in at build time via --dart-define (see
    # flutter/lib/config.dart). Without these the shipped app has an empty
    # base URL / Google client ids and sign-in can't work. Supplied by the
    # workflow from repo vars; skipped cleanly if unset (e.g. a local build).
    dart_defines = %w[RELAY_BASE_URL GOOGLE_IOS_CLIENT_ID GOOGLE_SERVER_CLIENT_ID]
                   .filter_map { |k| "--dart-define=#{k}=#{ENV[k]}" unless ENV[k].to_s.empty? }
                   .join(" ")

    UI.important("🔨 Building Flutter (release, no codesign)...")
    sh("cd ../.. && flutter build ios --release --no-codesign #{dart_defines}")

    # Sync certificates via match, then switch the project to manual signing
    # so the archive uses the Match-managed Distribution profile.
    sync_certificates

    update_code_signing_settings(
      use_automatic_signing: false,
      code_sign_identity: "Apple Distribution",
      path: "Runner.xcodeproj",
      bundle_identifier: APP_IDENTIFIER,
      profile_name: ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"],
      team_id: TEAM_ID
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      derived_data_path: "build",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfileMapping: {
          APP_IDENTIFIER => ENV["sigh_#{APP_IDENTIFIER}_appstore"]
        },
        uploadBitcode: true,
        uploadSymbols: true
      },
      output_directory: "build/",
      output_name: "relay.ipa",
      skip_package_ipa: false,
      skip_package_pkg: true,
      skip_profile_detection: true,
      xcargs: "-allowProvisioningUpdates -verbose"
    )

    UI.success("✅ IPA successfully built and signed!")
    UI.important("📦 IPA location: build/relay.ipa")
  end

  desc "Upload IPA to TestFlight (no waiting for processing; internal testers only)"
  lane :upload_testflight do
    # Upload only: don't wait for Apple's processing on the (expensive) macOS
    # runner. External distribution is `distribute_external` (CI job
    # `distribute-ios`, ubuntu). Beta review contact/notes live in App Store
    # Connect's TestFlight → Test Information page, not here.
    options = {
      ipa: "build/relay.ipa",
      app_platform: "ios",
      app_identifier: APP_IDENTIFIER,
      changelog: testflight_changelog,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    }

    unless File.exist?(File.join("..", options[:ipa]))
      UI.error("❌ IPA not found at #{options[:ipa]}. Run 'fastlane build_ipa' first.")
      raise "Missing IPA"
    end

    api_key = asc_api_key
    if api_key
      UI.important("📤 Uploading to TestFlight using App Store Connect API key...")
      options[:api_key] = api_key
    elsif ENV["FASTLANE_USER"] && ENV["FASTLANE_PASSWORD"]
      UI.important("📤 Uploading to TestFlight...")
    else
      UI.important("✅ IPA is ready at: #{options[:ipa]}")
      UI.important("📝 To upload, set FASTLANE_API_KEY_PATH or FASTLANE_USER/FASTLANE_PASSWORD, then run: fastlane upload_testflight")
      next
    end

    upload_to_testflight(**options)
    UI.success("✅ Uploaded to TestFlight (processing continues on Apple's side)!")
  end

  desc "Wait for an uploaded build to process, then submit it to the external beta group"
  lane :distribute_external do
    # Pinned to the exact build `upload_testflight` uploaded — never "latest".
    #   CI: build-ios job outputs (run number + pubspec version)
    build_num = ENV["BUILD_NUMBER"]
    if build_num.nil? || build_num.empty?
      UI.user_error!("❌ BUILD_NUMBER environment variable is required. Set it like: BUILD_NUMBER=123 APP_VERSION=1.0.0 fastlane distribute_external")
    end

    app_version = ENV["APP_VERSION"]
    if app_version.nil? || app_version.empty?
      UI.user_error!("❌ APP_VERSION environment variable is required. Set it like: BUILD_NUMBER=123 APP_VERSION=1.0.0 fastlane distribute_external")
    end

    # API-only path (runs on Linux) — no Apple ID fallback.
    api_key = asc_api_key
    if api_key.nil?
      UI.user_error!("❌ An App Store Connect API key is required. Set FASTLANE_API_KEY_PATH, APP_STORE_CONNECT_KEY_ID and APP_STORE_CONNECT_ISSUER_ID.")
    end

    group = beta_group
    UI.important("🚀 Distributing #{app_version} (#{build_num}) to external group '#{group}'...")
    upload_to_testflight(
      distribute_only: true,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      app_version: app_version,
      build_number: build_num,
      distribute_external: true,
      groups: [group],
      notify_external_testers: true,
      changelog: testflight_changelog,
      api_key: api_key
    )
    UI.success("✅ Build #{build_num} (#{app_version}) submitted to external beta (#{group})!")
  end

  desc "Write the next TestFlight build number to RELAY_BUILD_NUMBER_FILE (runner deploys)"
  lane :next_build_number do
    out = ENV["RELAY_BUILD_NUMBER_FILE"].to_s
    UI.user_error!("❌ RELAY_BUILD_NUMBER_FILE environment variable is required (bin/deploy_ios.sh sets it).") if out.empty?

    api_key = asc_api_key
    if api_key.nil?
      UI.user_error!("❌ An App Store Connect API key is required. Set FASTLANE_API_KEY_PATH, APP_STORE_CONNECT_KEY_ID and APP_STORE_CONNECT_ISSUER_ID.")
    end

    # latest_testflight_build_number answers for the latest app version by default. Builds CI
    # uploaded were numbered by github.run_number, so latest + 1 stays above all of them; a new
    # app version with no builds yet starts at 1, which TestFlight allows (build numbers are
    # unique per version).
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_IDENTIFIER, initial_build_number: 0)
    File.write(out, "#{latest + 1}\n")
    UI.success("🔢 Next TestFlight build number: #{latest + 1}")
  end

  desc "Build and upload to TestFlight"
  lane :deploy do
    build_ipa
    upload_testflight
  end
end
