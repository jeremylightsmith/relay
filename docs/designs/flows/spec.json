{
  "key": "spec",
  "isolation": "shared_clean",
  "trigger": { "stage": "Spec" },
  "nodes": [
    {
      "key": "brainstorm",
      "type": "agent",
      "run": "/brainstorm {ref}",
      "max_retries": 1,
      "reads": ["description"],
      "writes": ["spec", "acceptance_criteria"]
    }
  ],
  "edges": [
    { "from": "start", "to": "brainstorm" },
    { "from": "brainstorm", "to": "done", "on": "succeeded" },
    { "from": "brainstorm", "to": "needs_input", "on": "failed" }
  ]
}
