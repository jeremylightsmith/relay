#!/usr/bin/env python3
"""./relay is now ./hamaca (RE478) — this shim runs the ./hamaca beside it.

It is kept for the relay -> hamaca compatibility window so muscle memory, scripts and flows
that still say ./relay keep working. It is not a runner and never downloads anything: when
./hamaca is missing it says how to get it back and exits 1.
"""

import os
import sys

NOTE = "\x1b[2mnote: ./relay is now ./hamaca — use that name.\x1b[0m"
MISSING = ("relay: ./hamaca is missing next to this ./relay — run ./hamaca update, "
           "or re-run your board's install command.")

# Machine-readable output flags: a caller parsing stdout never wants a note on stderr either.
QUIET_FLAGS = ("--json", "--field")
# Set by the runner for every node subprocess (both names during the compatibility window).
NODE_ENV = ("HAMACA_NODE_SCRATCH", "RELAY_NODE_SCRATCH", "HAMACA_NODE_OUTCOME", "RELAY_NODE_OUTCOME")


def should_note(argv, environ, isatty):
    """True when a human at a terminal should see the rename note.

    These rules mirror the full runner's pre-migration note (the shim cannot import it): never
    in a pipe, never with --json/--field, never in `start` (its output is a log), never inside a
    node subprocess."""
    if not isatty:
        return False
    if any(arg in QUIET_FLAGS for arg in argv[1:]):
        return False
    if len(argv) > 1 and argv[1] == "start":
        return False
    return not any(name in environ for name in NODE_ENV)


def main():
    hamaca = os.path.join(os.path.dirname(os.path.abspath(__file__)), "hamaca")
    if not os.path.isfile(hamaca):
        print(MISSING, file=sys.stderr)
        sys.exit(1)
    if should_note(sys.argv, os.environ, sys.stderr.isatty()):
        print(NOTE, file=sys.stderr, flush=True)
    os.execv(sys.executable, [sys.executable, hamaca, *sys.argv[1:]])


if __name__ == "__main__":
    main()
